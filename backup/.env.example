# 서버가 사용할 포트 번호입니다. (기본값 3000)
PORT=3000

# 화면에 보여줄 순위 수 (기본값 5 = TOP5)
TOP_N=5

# ---- SOOP Chat SDK 연동 정보 (선택 사항) ----
# SOOP Developers 사이트에서 "제휴 제안" 신청 후 승인받으면
# "내 계정 > 내 API KEY" 메뉴에서 아래 두 값을 확인할 수 있습니다.
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=

# SOOP API KEY 신청 시 등록한 리다이렉트 주소입니다. (예: http://localhost:3000/settings.html)
# public/settings.html이 OAuth 로그인 후 돌아올 주소이며, SOOP에 등록한 값과 정확히 일치해야 합니다.
SOOP_REDIRECT_URI=

# public/settings.html(운영자 전용 설정 화면)에 접근할 때 사용하는 비밀 키입니다.
# 아무 값이나 정해서 넣고, 이 값을 아는 사람만 settings.html에서 연결/테스트/초기화 작업을 할 수 있습니다.
OPERATOR_TOKEN=

# 위 SOOP_CLIENT_ID/SECRET이 비어있으면 자동으로 테스트 모드로 동작하고,
# connect.html에서 로그인에 성공하면 자동으로 실시간 방송 모드로 전환됩니다.
