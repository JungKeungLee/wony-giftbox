# 서버가 사용할 포트 번호입니다. (기본값 3000)
PORT=3000

# 같은 스트리머(bj/nick)를 이 시간(밀리초) 안에 다시 요청하면
# SoopScope를 다시 호출하지 않고 캐시된 결과를 그대로 돌려줍니다. (기본 30000 = 30초)
CACHE_TTL_MS=30000

# ---- 선물상자 이벤트 ----
# 선물상자 DB (Neon PostgreSQL) 연결 문자열입니다. Neon 대시보드 > Connect 에서 "Pooled connection"을 복사하세요.
# 예: postgresql://사용자:비밀번호@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 비어 있으면 선물상자 기능만 꺼지고(503), 도전미션 TOP5는 그대로 동작합니다.
DATABASE_URL=

# /admin(관리자 화면) 로그인에 쓰는 비밀 키입니다. 반드시 길고 추측하기 어려운 값으로 정해주세요.
# 비어 있으면 관리자 기능이 꺼집니다. (OBS 오버레이 /overlay는 키 없이 조회만 가능)
OPERATOR_TOKEN=

# (선택) 프록시 뒤에서 실행할 때 신뢰할 프록시 단계 수. Render에서는 자동으로 1이 적용되므로 비워두면 됩니다.
# TRUST_PROXY=1

# (선택) DB 연결 풀 최대 개수. 기본값: 5
# GIFT_DB_POOL_MAX=5

# (선택) 연출 시간(밀리초). 기본값: 상자 오픈 11000 / 룰렛 회전 6500 / 당첨자 표시 4000
# GIFT_BOX_OPEN_MS=11000
# GIFT_SPIN_MS=6500
# GIFT_WINNER_HOLD_MS=4000

# (선택) 후원 1건 최대 개수 (오타 방지). 기본값: 1000000
# GIFT_MAX_DONATION_AMOUNT=1000000

# ---- SOOP 공식 별풍선 연동 (/soop-connector) ----
# SOOP Developers > 내 계정 > 애플리케이션에서 확인한 값입니다. 서버에서만 쓰고 브라우저에는 보내지 않습니다.
# 둘 중 하나라도 비어 있으면 SOOP 연동만 꺼지고 선물상자 다른 기능은 그대로 동작합니다.
# 애플리케이션의 Redirect URL에는 https://<서비스 주소>/soop-connector/callback 을 등록하세요.
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=

# (권장) 별풍선을 집계할 방송인 SOOP 아이디. 설정하면 다른 계정으로 연결했을 때 그 별풍선은 집계하지 않습니다.
# SOOP_BJ_ID=
